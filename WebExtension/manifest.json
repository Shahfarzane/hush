{
  "manifest_version": 3,
  "name": "Hush",
  "description": "Answers cookie banners with the cookie level you chose in Hush.",
  "version": "1.0",
  "permissions": ["storage", "nativeMessaging", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
