[
  {
    "name": "MediaMarkt",
    "sites": ["mediamarkt.nl"],
    "banner": "[data-test='mms-privacy-layer']",
    "acceptAll": "[data-test='pwa-consent-layer-accept-all']",
    "save": "[data-test='pwa-consent-layer-save-settings']",
    "switches": [
      {
        "selector": "[role='switch']#toggle-category-Comfortabel",
        "categories": ["functional", "performance"]
      },
      {
        "selector": "[role='switch']#toggle-category-Marketing",
        "categories": ["advertising"]
      }
    ],
    "switchState": "aria-checked"
  },
  {
    "name": "Thincast",
    "sites": ["thincast.com"],
    "banner": "#modal-center:has(#RejectCookies)",
    "reject": "#RejectCookies",
    "acceptAll": "#AcceptCookies"
  },
  {
    "name": "Acceptrics",
    "sites": ["vpnunlimited.com"],
    "banner": "#acceptricsCookieBanner",
    "reject": "#acceptricsRejectAllBtn",
    "acceptAll": "#acceptricsAcceptAllBtn",
    "openSettings": "#acceptricsChooseSettingsBtn",
    "save": "#acceptricsSaveSettingsBtn",
    "switches": [
      {
        "selector": "#acceptricsCookieModal input#functional",
        "categories": ["functional"]
      },
      {
        "selector": "#acceptricsCookieModal input#analytics",
        "categories": ["performance"]
      },
      {
        "selector": "#acceptricsCookieModal input#marketing",
        "categories": ["advertising"]
      }
    ],
    "switchState": "checkbox"
  },
  {
    "name": "Revolut",
    "sites": ["revolut.com"],
